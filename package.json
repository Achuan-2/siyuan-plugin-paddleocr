{
  "name": "siyuan-plugin-paddleocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:release && pnpm run make_dev_copy",
    "build:release": "pnpm run sync-version && vite build && node scripts/package-plugin.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "make_dev_copy": "node scripts/copy-to-siyuan.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "siyuan": "1.2.7",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vite-plugin-static-copy": "^3.1.0"
  }
}
